<?xml version="1.0" encoding="UTF-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Das Textfeld für Titel und Text -->
    <TextView
        android:id="@+id/custom_snackbar_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <!-- Container für Ihre zwei klickbaren Icon-Buttons unten rechts -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="8dp">

        <!-- Icon 1: Korrigiert mit app:tint und Theme-Attribut -->
        <ImageButton
            android:id="@+id/custom_btn_one"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/icon_share"
            app:tint="?android:attr/textColorPrimaryInverse" /> <!-- FEHLER BEHOBEN -->

        <!-- Icon 2: Korrigiert mit app:tint und Theme-Attribut -->
        <ImageButton
            android:id="@+id/custom_btn_two"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/icon_close"
            app:tint="?android:attr/textColorPrimaryInverse" /> <!-- FEHLER BEHOBEN -->

    </LinearLayout>
</LinearLayout>